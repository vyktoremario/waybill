{
  "expo": {
    "name": "Waybill Driver",
    "slug": "waybill-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "test.waybill.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Waybill shares your location with dispatch and the customer while you are on a delivery.",
        "NSCameraUsageDescription": "Take a photo of the parcel at pickup."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "test.waybill.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Waybill shares your location with dispatch and the customer while you are on a delivery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take a photo of the parcel at pickup."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F7F8FA"
        }
      ]
    ],
    "scheme": "waybill-driver",
    "extra": {
      "eas": {
        "projectId": "ebf12fbe-fc53-409e-be00-18d8a0729239"
      }
    },
    "owner": "mariomobile"
  }
}
